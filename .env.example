# Copia este archivo como ".env" y rellena los valores.
# El .env real NO se sube al repo (está en .gitignore).

# --- Base de datos (MongoDB local o Atlas) ---
DB_URL=mongodb://127.0.0.1:27017/protectora

# --- Servidor ---
PORT=5002
NODE_ENV=development

# --- Sesión / JWT ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_KEY=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d
# En local (mismo sitio) vale "strict". En producción cross-site usa "none" + HTTPS.
COOKIE_SAMESITE=strict
# COOKIE_MAX_AGE=86400000

# --- CORS: origin del FRONTEND (Angular), separados por comas ---
CORS_ORIGINS=http://localhost:4200

# --- RescueGroups (fuente de los animales) ---
RESCUEGROUPS_APIKEY=tu_api_key_de_rescuegroups
RESCUEGROUPS_API_URL=https://api.rescuegroups.org/http/v2.json

# --- Seed (opcional) ---
# SEED_RESET=collections
